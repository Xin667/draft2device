# Vorlage für die lokale Konfiguration.
#
# Benutzen:
#   cp .env.example .env
#   # dann in .env den echten Key eintragen
#
# .env wird NICHT eingecheckt (siehe .gitignore) - sie enthält ein Secret.
# Falls die Datei fehlt, greift config.py alternativ auf eine lokale key.py
# oder auf die bereits exportierte Umgebungsvariable zurück.

OPENAI_API_KEY=sk-proj-hier-den-echten-key-eintragen
